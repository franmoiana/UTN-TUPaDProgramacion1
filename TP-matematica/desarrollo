while True:
    print("---- Clasificador de Proposiciones Compuestas ----")
    print()
    print("Tenga en cuenta que el sistema trabaja con un maximo de 3 variables")
    print()

    # Solicitud y validacion de cantidad de variables
    while True:
        cantidad_variables = input("¿Con que cantidad de variables va a trabajar?: ")
        print()
        if cantidad_variables.isdigit():
            cantidad_variables = int(cantidad_variables)
            if cantidad_variables > 1 and cantidad_variables < 4:
                break
            else:
                print("Error: el programa permite entre 2 y 3 variables")
                print()
        else:
            print("Error: ingrese un numero valido")
            print()

    # Solicitud de nombre y negacion de cada variable
    lista_variables = []
    for i in range(1, cantidad_variables + 1):
        while True:
            nombre = input(f"Ingrese el nombre de la variable numero {i}: ")
            print()
            # Validacion: no puede estar vacio
            nombre_vacio = True
            for caracter in nombre:
                if caracter != " ":
                    nombre_vacio = False
                    break
            if nombre == "" or nombre_vacio:
                print("Error: el nombre no puede estar vacio")
                print()
                continue
            # Validacion: no puede contener espacios
            tiene_espacio = False
            for caracter in nombre:
                if caracter == " ":
                    tiene_espacio = True
                    break
            if tiene_espacio:
                print("Error: el nombre no puede contener espacios")
                print()
                continue
            # Validacion: no puede ser un numero
            es_numero = True
            for caracter in nombre:
                if not caracter.isdigit():
                    es_numero = False
                    break
            if es_numero:
                print("Error: el nombre no puede ser un numero")
                print()
                continue
            break
        while True:
            negada = input(f"¿La variable '{nombre}' esta negada? (Y / N): ").upper()
            print()
            if negada == "Y":
                lista_variables.append((nombre, True))
                break
            elif negada == "N":
                lista_variables.append((nombre, False))
                break
            else:
                print("Error: ingrese Y o N")

    # Solicitud de operadores entre cada par de variables
    lista_operadores = []
    for i in range(1, cantidad_variables):
        print()
        print(f"¿Que operador desea utilizar entre '{lista_variables[i-1][0]}' y '{lista_variables[i][0]}'?")
        print("1. AND  (∧)")
        print("2. OR   (∨)")
        print("3. Implicacion      (→)")
        print("4. Doble implicacion (↔)")
        print()
        while True:
            opcion = input("Ingrese la opcion: ")
            if opcion.isdigit():
                opcion = int(opcion)
                if opcion == 1:
                    lista_operadores.append("∧")
                    break
                elif opcion == 2:
                    lista_operadores.append("∨")
                    break
                elif opcion == 3:
                    lista_operadores.append("→")
                    break
                elif opcion == 4:
                    lista_operadores.append("↔")
                    break
                else:
                    print("Error: ingrese una opcion entre 1 y 4")
                    print()
            else:
                print("Error: ingrese una opcion valida")
                print()

    # Funcion para mostrar la variable con su negacion si corresponde
    def mostrar_variable(variable):
        nombre = variable[0]
        negada = variable[1]
        if negada:
            return "¬" + nombre
        else:
            return nombre

    # Construccion de la proposicion compuesta como string
    proposicion_compuesta = ""
    for i in range(len(lista_variables)):
        proposicion_compuesta += mostrar_variable(lista_variables[i])
        if i < len(lista_variables) - 1:
            proposicion_compuesta += " " + lista_operadores[i] + " "

    print()
    print(f"Proposicion ingresada: {proposicion_compuesta}")
    print()

    # Deteccion de nombres unicos para evitar combinaciones imposibles
    nombres_unicos = []
    for var in lista_variables:
        if var[0] not in nombres_unicos:
            nombres_unicos.append(var[0])

    cantidad_unica = len(nombres_unicos)

    # Generacion de combinaciones segun variables unicas
    if cantidad_unica == 1:
        combinaciones = [
            [True],
            [False]
        ]
    elif cantidad_unica == 2:
        combinaciones = [
            [True, True],
            [True, False],
            [False, True],
            [False, False]
        ]
    elif cantidad_unica == 3:
        combinaciones = [
            [True, True, True],
            [True, True, False],
            [True, False, True],
            [True, False, False],
            [False, True, True],
            [False, True, False],
            [False, False, True],
            [False, False, False]
        ]

    # Expansion de cada fila al tamaño real de lista_variables
    combinaciones_expandidas = []
    for fila in combinaciones:
        fila_expandida = []
        for var in lista_variables:
            indice = nombres_unicos.index(var[0])
            fila_expandida.append(fila[indice])
        combinaciones_expandidas.append(fila_expandida)

    # Aplicacion de negaciones segun las variables negadas
    combinaciones_evaluadas = []
    for fila in combinaciones_expandidas:
        fila_evaluada = []
        for j in range(len(fila)):
            if lista_variables[j][1] == True:
                fila_evaluada.append(not fila[j])
            else:
                fila_evaluada.append(fila[j])
        combinaciones_evaluadas.append(fila_evaluada)

    # Funcion para evaluar dos valores con un operador logico
    def evaluar(val1, operador, val2):
        if operador == "∧":
            return val1 and val2
        elif operador == "∨":
            return val1 or val2
        elif operador == "→":
            return not val1 or val2
        elif operador == "↔":
            return (val1 and val2) or (not val1 and not val2)

    # Evaluacion de cada fila de izquierda a derecha
    resultados = []
    for fila in combinaciones_evaluadas:
        resultado = fila[0]
        for i in range(len(lista_operadores)):
            resultado = evaluar(resultado, lista_operadores[i], fila[i+1])
        resultados.append(resultado)

    # Impresion del encabezado de la tabla
    for i in lista_variables:
        print(mostrar_variable(i), end="   ")
    print(proposicion_compuesta)

    # Impresion de cada fila de la tabla
    for i in range(len(combinaciones_evaluadas)):
        for valor in combinaciones_evaluadas[i]:
            if valor:
                print("V  ", end="  ")
            else:
                print("F  ", end="  ")
        if resultados[i]:
            print("V")
        else:
            print("F")

    print()

    # Clasificacion de la proposicion
    if True in resultados and False in resultados:
        print("Clasificacion: CONTINGENCIA")
    elif True in resultados:
        print("Clasificacion: TAUTOLOGIA")
    else:
        print("Clasificacion: CONTRADICCION")

    # Pregunta para volver a ejecutar
    print()
    while True:
        repetir = input("¿Desea clasificar otra proposicion? (Y / N): ").upper()
        if repetir == "Y":
            print()
            break
        elif repetir == "N":
            print()
            print("Gracias por usar el Clasificador. Hasta luego.")
            exit()
        else:
            print("Error: ingrese Y o N")